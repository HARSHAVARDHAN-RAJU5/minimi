# Copy this file to .env and fill in the values. .env is never committed.

# Required. Gemini, the AI model. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required. Main web search. Free key (2,500 searches/month, no card): https://dashboard.exa.ai
EXA_API_KEY=

# Optional. Backup web search, used if Exa fails or runs out. Free key (1,000/month, no card): https://app.tavily.com
TAVILY_API_KEY=

# Optional. Model for answers (default: gemini-3.8-flash).
GEMINI_MODEL=

# Optional. Fast model for small background jobs (default: gemini-3.5-flash-lite).
GEMINI_FAST_MODEL=

# Optional. Who builds the web searches (default: code-first).
#   code-first = code builds them from product names; the AI planner is the backup when code finds none.
#   planner    = the AI planner always decides.
SEARCH_MODE=

# Optional. Port for the web page (default: 3000).
PORT=

# Optional. Where chats are saved (default: data/minimi.db).
DB_PATH=
