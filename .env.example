# Copy this file to .env and fill in the values.

# Required. Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Which Gemini model to use (default: gemini-2.5-flash).
GEMINI_MODEL=

# Optional. Backup web search if Gemini's search limit is reached. Free key: https://tavily.com
TAVILY_API_KEY=

# Optional. Port for the web page (default: 3000).
PORT=
