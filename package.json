{
  "name": "minimi-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Chat agent with web search and long-term memory",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "typecheck": "tsc --noEmit",
    "eval:planner": "tsx scripts/eval-planner.ts",
    "eval:speed": "tsx scripts/eval-speed.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "express": "^5.3.0"
  }
}
